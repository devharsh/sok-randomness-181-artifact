<mxfile host="drawio"><diagram id="fig2" name="coldcard_faultpath"><mxGraphModel dx="800" dy="400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Seed request&lt;br&gt;&lt;font face='Courier New' style='font-size:10px'&gt;ngu.random&lt;br&gt;.bytes()&lt;/font&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="101" height="92" as="geometry"/></mxCell><mxCell id="c3" value="&lt;i&gt;Intended&lt;/i&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;text;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="109" y="0" width="210" height="14" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font face='Courier New' style='font-size:10px'&gt;rng_get()&lt;/font&gt; calls the hardware TRNG wrapper" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#d5e8d4;strokeColor=#3a7d34;" vertex="1" parent="1"><mxGeometry x="109" y="16" width="210" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Seed with the intended 128 bits of entropy" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#d5e8d4;strokeColor=#3a7d34;" vertex="1" parent="1"><mxGeometry x="327" y="16" width="210" height="36" as="geometry"/></mxCell><mxCell id="c6" value="&lt;i&gt;Shipped, March 2021 to 2026&lt;/i&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;text;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="109" y="58" width="303" height="14" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font face='Courier New' style='font-size:10px'&gt;rng_get()&lt;/font&gt; resolves to the Yasmarang PRNG &lt;b&gt;(S3)&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="109" y="74" width="101" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Seeded once from low 32 bits of UID, SysTick, RTC &lt;b&gt;(S4)&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="218" y="74" width="101" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Mk4, Q, Mk5: secure-element bits cut to 32, reseed one state word &lt;b&gt;(S5)&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="327" y="74" width="101" height="70" as="geometry"/></mxCell><mxCell id="c10" value="BIP-39 phrase, BIP-32 keys, addresses on the public chain" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="436" y="74" width="101" height="70" as="geometry"/></mxCell><mxCell id="c11" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#3a7d34;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#3a7d34;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#b85450;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#b85450;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#b85450;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#b85450;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Build guard tests &lt;font face='Courier New' style='font-size:10px'&gt;#ifndef&lt;/font&gt; on a macro defined as 0, so its &lt;font face='Courier New' style='font-size:10px'&gt;#error&lt;/font&gt; never fires and the fallback is linked &lt;b&gt;(S*)&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#ffffff;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="0" y="166" width="210" height="58" as="geometry"/></mxCell><mxCell id="c18" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#b85450;dashed=1;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c17" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Attacker enumerates candidate seeds offline and matches derived addresses against funded ones, without access to any device &lt;b&gt;(A1)&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=1;arcSize=8;strokeWidth=1.3;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="228" y="166" width="309" height="58" as="geometry"/></mxCell><mxCell id="c20" style="endArrow=block;endFill=1;endSize=5;strokeWidth=1.3;html=1;strokeColor=#d79b00;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Search space, disputed. Vendor: about 2&lt;sup&gt;40&lt;/sup&gt; (Mk2, Mk3) and 2&lt;sup&gt;72&lt;/sup&gt; (Mk4, Mk5, Q). Block: at most 2&lt;sup&gt;32&lt;/sup&gt; output streams once the fallback state and call history are known, raw ceiling about 2&lt;sup&gt;73&lt;/sup&gt;." style="fontFamily=Helvetica;fontColor=#000000;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=6;spacingRight=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="0" y="238" width="537" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>